---
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import WhatsApp from '../components/WhatsApp.astro';
import hero from '../../SAMARA_M0_v1.2_Corrected_Assets/web_zip_14/Vine-Covered Garden Event Seating.webp';
import buffet from '../../SAMARA_M0_v1.2_Corrected_Assets/web_zip_14/Elegant Outdoor Buffet Pavilion Setup.webp';
import setup from '../../SAMARA_M0_v1.2_Corrected_Assets/web_zip_14/Elegant Garden Event Venue Setup.webp';
import garden from '../../SAMARA_M0_v1.2_Corrected_Assets/web_zip_14/Bright Backyard Garden with Tree and Patio.webp';
import veranda from '../../SAMARA_M0_v1.2_Corrected_Assets/web_zip_14/Sunlit Veranda with Blue Event Chairs.webp';
import stage from '../../SAMARA_M0_v1.2_Corrected_Assets/web_zip_14/Ornate Red and Blue Stage Seating.webp';
import exterior from '../../SAMARA_M0_v1.2_Corrected_Assets/web_zip_14/Bright White House with Golden Trim.webp';
import courtyard from '../../SAMARA_M0_v1.2_Corrected_Assets/web_zip_14/Bright Garden Courtyard with Potted Plants.webp';
import corridor from '../../SAMARA_M0_v1.2_Corrected_Assets/web_zip_14/Spotless Patterned Corridor Garden View.webp';
import driveway from '../../SAMARA_M0_v1.2_Corrected_Assets/web_zip_14/Bright Modern House Exterior.webp';
import ceremony from '../../SAMARA_M0_v1.2_Corrected_Assets/web_zip_14/Vine-Covered Garden Ceremony Seating.webp';
import floralStage from '../../SAMARA_M0_v1.2_Corrected_Assets/web_zip_14/Elegant Pink Marble Wedding Stage with Flowers.webp';
import collage from '../../SAMARA_M0_v1.2_Corrected_Assets/web_zip_14/Elegant Garden Wedding Venue Collage.webp';
import '../styles/site.css';

const title = 'SAMARA | Sewa Tempat Hajatan & Acara Keluarga di Cibogo, Cianjur';
const description = 'Sewa tempat hajatan bernuansa rumah dan taman di Cibogo, Cianjur. Rp2.500.000 untuk 7–8 jam acara, bebas pilih vendor. Cek tanggal atau jadwalkan survei SAMARA.';
const canonical = Astro.site && new URL('/', Astro.site);
const address = 'Cibogo Komplek,no 16, Bobojong, Mande, Cianjur';
const mapsUrl = import.meta.env.SAMARA_MAPS_URL || 'https://maps.app.goo.gl/pRW6bfU7FuKyu4Lj7';
const nav = [['Venue', '#venue'], ['Galeri', '#galeri'], ['Harga', '#harga'], ['Lokasi', '#lokasi']];
const setupLabel = 'Penataan acara';
const venueLabel = 'Dokumentasi venue';
const decorationLabel = 'Dekorasi acara';
const heroAlt = 'Deretan kursi kayu di halaman rumput di bawah tanaman rambat';
const setupAlt = 'Tenda putih, kursi biru, dan area dekorasi di tepi halaman';
const gardenAlt = 'Hamparan rumput dan pohon di samping teras';
const exteriorAlt = 'Fasad rumah putih dengan pagar hitam dan lis keemasan';

const photos = [
  { image: veranda, group: 'acara', label: setupLabel, caption: 'Teras dengan kursi biru', alt: 'Deretan kursi biru di bawah tenda putih, terlihat dari sisi teras' },
  { image: stage, group: 'acara', label: setupLabel, caption: 'Dekorasi merah putih di teras', alt: 'Kursi dan dekorasi kain merah putih di teras' },
  { image: exterior, group: 'akses', label: venueLabel, caption: 'Fasad dan gerbang', alt: exteriorAlt },
  { image: courtyard, group: 'venue', label: venueLabel, caption: 'Taman dan tanaman pot', alt: 'Tanaman pot di tepi halaman berumput dengan pohon dan jalur kecil' },
  { image: corridor, group: 'akses', label: venueLabel, caption: 'Lorong menuju halaman', alt: 'Lorong berlantai ubin berpola dengan bukaan ke taman' },
  { image: buffet, group: 'acara', label: setupLabel, caption: 'Penataan meja prasmanan', alt: 'Deretan meja prasmanan di dekat teras dan kursi biru' },
  { image: setup, group: 'acara', label: setupLabel, caption: 'Penataan teras dan halaman', alt: setupAlt },
  { image: garden, group: 'venue', label: venueLabel, caption: 'Halaman belakang dan teras', alt: gardenAlt },
  { image: driveway, group: 'akses', label: venueLabel, caption: 'Jalur masuk dari halaman depan', alt: 'Jalur masuk berubin dari halaman depan menuju teras' },
  { image: hero, group: 'dekorasi', label: decorationLabel, caption: 'Susunan kursi kayu di taman', alt: heroAlt },
  { image: ceremony, group: 'dekorasi', label: decorationLabel, caption: 'Kursi kayu di bawah tanaman rambat', alt: 'Kursi kayu berjajar di taman dengan tanaman rambat di atasnya' },
  { image: floralStage, group: 'dekorasi', label: decorationLabel, caption: 'Pelaminan dengan rangkaian bunga', alt: 'Rangkaian bunga warna-warni dengan latar merah muda dan kursi berbingkai emas' },
  { image: collage, group: 'dekorasi', label: decorationLabel, caption: 'Kolase penataan acara', alt: 'Kolase dekorasi bunga, susunan kursi di taman, dan penataan teras' },
];
const filters = [['semua', 'Semua Foto'], ['acara', 'Penataan Acara'], ['venue', 'Area Venue'], ['akses', 'Akses & Fasilitas'], ['dekorasi', 'Dekorasi Acara']];
const events = [['rings', 'Akad Nikah'], ['heart', 'Lamaran'], ['flowers', 'Syukuran Pernikahan'], ['people', 'Acara Keluarga']];
const faqs = [
  ['Boleh membawa vendor sendiri?', 'Ya, Anda bebas memilih vendor sendiri.'],
  ['Apa saja yang termasuk sewa?', 'Penggunaan area yang disepakati, toilet, listrik, dan kebersihan. Pemakaian alat berdaya tinggi perlu dibicarakan terlebih dahulu. Penggunaan ruangan dalam rumah perlu disepakati terpisah.'],
  ['Apakah kursi, tenda, dan dekorasi sudah termasuk?', 'Belum. Kursi, tenda, dekorasi, dan katering disiapkan bersama vendor pilihan Anda.'],
  ['Apakah waktu pemasangan dekorasi dihitung dalam 7–8 jam?', 'Waktu pemasangan dan pembongkaran dekorasi berada di luar durasi acara. Jadwal akses vendor disepakati terpisah.'],
  ['Bagaimana cara booking?', 'Tanggal dikunci dengan DP dan pelunasan dilakukan H-1 acara. Hubungi SAMARA untuk membicarakan ketentuan pemesanan.'],
  ['Berapa kapasitas tamu?', 'SAMARA dapat menampung 150 tamu. Konfirmasikan jumlah akhir sesuai tata letak acara.'],
  ['Bagaimana pengaturan parkir?', 'Pengaturan parkir dikoordinasikan dengan warga atau pengurus kompleks. Sampaikan kebutuhan parkir saat menjadwalkan survei.'],
];
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FAFCF8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content="SAMARA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={canonical ? new URL('/samara-fasad-og.jpg', canonical) : '/samara-fasad-og.jpg'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Foto tampak depan SAMARA di Cibogo, Cianjur" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" href="/fonts/cormorant-garamond-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body id="atas">
    <a class="skip-link" href="#konten">Lewati ke konten</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href="#atas" class="brand" aria-label="SAMARA, kembali ke atas">
          <img src="/logo-samara.webp" width="350" height="98" alt="SAMARA" />
        </a>
        <nav class="desktop-nav" aria-label="Navigasi utama">
          {nav.map(([label, href]) => <a href={href}>{label}</a>)}
        </nav>
        <div class="header-actions">
          <WhatsApp label="Tanya Jadwal" class="button--header" />
          <details class="mobile-nav">
            <summary aria-label="Menu navigasi"><Icon name="menu" /></summary>
            <nav aria-label="Navigasi utama">
              {nav.map(([label, href]) => <a href={href}>{label}</a>)}
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="konten">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="hero-location"><Icon name="pin" size={16} /><span>Tempat Hajatan &amp; Acara Keluarga <span class="hero-dot" aria-hidden="true">·</span> Cibogo, Cianjur</span></p>
          <h1 id="hero-title">Momen Spesial Keluarga, <em>Tak Harus di Gedung Besar.</em></h1>
          <p class="hero-intro">SAMARA menghadirkan tempat hajatan dengan suasana rumah dan taman yang hangat. Cocok untuk akad, syukuran pernikahan, lamaran, dan acara keluarga.</p>
          <p class="hero-price"><span class="price-label">Sewa venue</span> <strong>Rp2.500.000</strong> <span class="price-duration">/ 7–8 jam acara</span></p>
          <p class="hero-includes">Bebas pilih vendor <span aria-hidden="true">·</span> Toilet, listrik &amp; kebersihan termasuk</p>
          <div class="flex flex-wrap items-center gap-x-5 gap-y-2 hero-actions">
            <WhatsApp label="Tanya Ketersediaan Tanggal" class="button--primary" />
            <a class="text-link" href="#galeri">Lihat Galeri Venue <Icon name="arrow" size={17} /></a>
          </div>
        </div>
        <figure class="hero-figure">
          <Image src={hero} widths={[432, 696, 960, 1280, 1536]} sizes="(width < 760px) calc(100vw - 36px), (min-width: 1320px) 660px, 51vw" width={1280} format="webp" quality={77} loading="eager" fetchpriority="high" alt={heroAlt} />
          <figcaption><Icon name="camera" size={16} /> Penataan acara di SAMARA</figcaption>
        </figure>
      </section>

      <section aria-label="Informasi singkat sewa" class="facts">
        <dl class="wrap facts-grid">
          <div><dt>Sewa tempat</dt><dd>Rp2,5 juta</dd></div>
          <div><dt>Durasi acara</dt><dd>7–8 jam</dd></div>
          <div><dt>Jumlah tamu</dt><dd>150 orang</dd><dd class="fact-note">Jumlah akhir dikonfirmasi sesuai penataan.</dd></div>
          <div><dt>Luas keseluruhan properti</dt><dd>480 m²</dd></div>
        </dl>
      </section>

      <section class="section wrap venue" id="venue" aria-labelledby="venue-title">
        <div class="section-copy">
          <h2 id="venue-title">Ruang Hangat untuk Berkumpul dan Merayakan.</h2>
          <p>Berangkat dari suasana halaman rumah yang akrab, SAMARA menjadi pilihan bagi keluarga yang membutuhkan tempat untuk merayakan momen penting. Dengan teras, taman, serta area yang bisa ditata sesuai kebutuhan, Anda dapat membawa vendor pilihan sendiri.</p>
          <a href="#galeri" class="text-link">Jelajahi area venue <Icon name="arrow" size={17} /></a>
        </div>
        <div class="venue-pair">
          <figure>
            <Image src={garden} width={640} widths={[384, 640, 880]} sizes="(min-width: 760px) 29vw, 54vw" format="webp" alt={gardenAlt} />
            <figcaption>Taman SAMARA</figcaption>
          </figure>
          <figure>
            <Image src={setup} width={432} widths={[280, 432, 640]} sizes="(min-width: 760px) 20vw, 39vw" format="webp" alt={setupAlt} />
            <figcaption>Penataan teras dan halaman</figcaption>
          </figure>
        </div>
      </section>

      <section class="section gallery" id="galeri" aria-labelledby="gallery-title">
        <div class="wrap">
          <div class="gallery-heading">
            <h2 id="gallery-title">Lihat Suasana SAMARA dari Dekat.</h2>
            <button type="button" class="text-link" data-open-all hidden>Lihat semua foto <Icon name="arrow" size={17} /></button>
          </div>
          <p class="gallery-note">Foto-foto ini mendokumentasikan area venue dan penataan acara di SAMARA. Kursi, tenda, dan dekorasi disiapkan terpisah.</p>
          <div class="gallery-filters flex flex-wrap gap-2" role="group" aria-label="Filter galeri" hidden>
            {filters.map(([key, label]) => <button type="button" data-filter={key} aria-pressed="false">{label}</button>)}
          </div>
          <div class="gallery-grid" data-view="pilihan">
            {photos.map((photo, index) => (
              <figure data-group={photo.group} class:list={['gallery-item', { 'gallery-featured': index === 0 }]} hidden={index > 4}>
                <a href={photo.image.src} class="gallery-link" data-photo={index} aria-label={`Perbesar foto: ${photo.caption}`}>
                  <Image src={photo.image} width={index === 0 ? 768 : 480} widths={index === 0 ? [432, 768, 1056] : [280, 480, 768]} sizes={index === 0 ? '(min-width: 760px) 44vw, 92vw' : '(min-width: 760px) 26vw, 46vw'} format="webp" alt={photo.alt} />
                  <span class="gallery-zoom"><Icon name="plus" size={17} /></span>
                </a>
                <figcaption>{photo.caption} <span class="gallery-label">· {photo.label}</span></figcaption>
              </figure>
            ))}
          </div>
          <dialog class="lightbox" aria-labelledby="lightbox-title">
            <div class="lightbox-inner">
              <div class="lightbox-toolbar">
                <h3 id="lightbox-title">Galeri SAMARA</h3>
                <button class="icon-button" type="button" data-close aria-label="Tutup galeri" autofocus><Icon name="close" /></button>
              </div>
              <img class="lightbox-image" src={photos[0].image.src} alt={photos[0].alt} loading="lazy" />
              <div class="lightbox-caption">
                <button class="icon-button" type="button" data-step="-1" aria-label="Foto sebelumnya"><Icon name="prev" /></button>
                <p aria-live="polite"></p>
                <button class="icon-button" type="button" data-step="1" aria-label="Foto berikutnya"><Icon name="next" /></button>
              </div>
            </div>
          </dialog>
        </div>
      </section>

      <section class="section wrap occasions" aria-labelledby="occasions-title">
        <div class="section-copy">
          <h2 id="occasions-title">Cocok untuk Acara Apa?</h2>
          <p>Beragam acara dapat disesuaikan dengan tata letak dan kebutuhan keluarga. Tanyakan rencana jumlah tamu dan penataan sebelum memesan.</p>
        </div>
        <ul class="occasions-grid">
          {events.map(([icon, event]) => <li><Icon name={icon} size={27} /><span>{event}</span></li>)}
        </ul>
      </section>

      <section class="section pricing" id="harga" aria-labelledby="pricing-title">
        <div class="wrap">
          <h2 id="pricing-title">Harga Jelas, Persiapan Lebih Fleksibel.</h2>
          <div class="price-card">
            <div class="price-main">
              <p>Sewa venue</p>
              <p class="price-amount">Rp2.500.000</p>
              <p>Untuk 7–8 jam acara</p>
              <WhatsApp label="Konsultasikan Rencana Acara" topic="price" class="button--light" />
            </div>
            <div class="price-details">
              <div class="price-inclusions">
                <div>
                  <h3>Sudah termasuk</h3>
                  <ul>
                    {['Toilet', 'Listrik', 'Kebersihan'].map(item => <li><Icon name="check" size={17} /> {item}</li>)}
                  </ul>
                </div>
                <div>
                  <h3>Belum termasuk</h3>
                  <p>Kursi, tenda, dekorasi, dan katering.</p>
                </div>
              </div>
              <dl class="terms">
                <div><dt>Vendor</dt><dd>Bebas pilih vendor sendiri.</dd></div>
                <div><dt>Jadwal dekorasi</dt><dd>Pemasangan dan pembongkaran di luar durasi acara, sesuai kesepakatan jadwal.</dd></div>
                <div><dt>Booking</dt><dd>DP mengunci tanggal. Pelunasan H-1 acara.</dd></div>
                <div><dt>Parkir</dt><dd>Perlu koordinasi dengan warga kompleks.</dd></div>
              </dl>
            </div>
          </div>
          <aside class="atha" aria-labelledby="atha-title">
            <div class="section-copy">
              <h3 id="atha-title">Lebih Praktis dengan Atha Decoration.</h3>
              <p>Bebas memilih vendor sendiri. Jika menggunakan Atha Decoration, tersedia diskon khusus untuk sewa SAMARA. Tanyakan pilihan dekorasi dan harga paket yang sesuai kebutuhan acara.</p>
            </div>
            <WhatsApp label="Tanya Paket Dekorasi" topic="decoration" class="button--outline" />
          </aside>
        </div>
      </section>

      <section class="section wrap location" id="lokasi" aria-labelledby="location-title">
        <figure class="location-photo">
          <Image src={exterior} width={960} widths={[432, 768, 960, 1280]} sizes="(min-width: 760px) 48vw, 92vw" format="webp" alt={exteriorAlt} />
          <figcaption>Tampak depan SAMARA</figcaption>
        </figure>
        <div class="section-copy">
          <h2 id="location-title">Datang dan Lihat Tempatnya Langsung.</h2>
          <p>Survei venue dapat dijadwalkan terlebih dahulu agar keluarga kami bisa membantu menunjukkan area dan menjelaskan ketentuan sewa.</p>
          <p class="location-name"><Icon name="pin" size={18} /> {address}</p>
          <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
            <WhatsApp label="Atur Jadwal Survei" topic="visit" class="button--primary" />
            <a class="text-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Buka Pin SAMARA <Icon name="external" size={16} /></a>
          </div>
        </div>
      </section>

      <section class="section faq" aria-labelledby="faq-title">
        <div class="wrap faq-grid">
          <h2 id="faq-title">Pertanyaan Umum</h2>
          <div class="faq-list">
            {faqs.map(([question, answer]) => (
              <details name="pertanyaan">
                <summary>{question}<Icon name="plus" size={18} /></summary>
                <p>{answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="section closing" aria-labelledby="closing-title">
        <div class="wrap closing-grid">
          <div class="section-copy">
            <h2 id="closing-title">Sudah Punya Tanggal untuk Acara Keluarga?</h2>
            <p>Ceritakan rencana acara Anda. Kami bantu cek jadwal, menjelaskan fasilitas, dan mengatur waktu survei.</p>
            <WhatsApp label="Chat SAMARA via WhatsApp" topic="general" class="button--light" />
          </div>
          <form id="inquiry" aria-labelledby="inquiry-title" aria-describedby="inquiry-note" hidden>
            <h3 id="inquiry-title">Kirim Rencana Acara</h3>
            <div class="inquiry-fields">
              <label>Tanggal acara <input type="date" name="date" required /></label>
              <label>Jenis acara
                <select name="event" required>
                  <option value="">Pilih acara</option>
                  {events.map(([, event]) => <option>{event}</option>)}
                  <option>Lainnya</option>
                </select>
              </label>
              <label>Estimasi jumlah tamu <input type="number" name="guests" min="1" step="1" inputmode="numeric" placeholder="Contoh: 80" required /></label>
            </div>
            <button type="submit" class="button button--accent">Lanjut ke WhatsApp <Icon name="arrow" size={17} /></button>
            <p id="inquiry-note">Periksa isi pesan sebelum mengirimnya di WhatsApp.</p>
          </form>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-main">
          <div class="footer-brand">
            <img src="/emblem-samara.webp" width="96" height="96" alt="SAMARA" loading="lazy" />
            <p>Tempat Hajatan &amp; Acara Keluarga<br /><span>{address}</span></p>
          </div>
          <div class="footer-links">
            <WhatsApp label="0813-2217-2075" topic="general" class="button--footer" />
            <a class="text-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Buka Pin SAMARA <Icon name="external" size={16} /></a>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} SAMARA</span>
          <details>
            <summary>Kebijakan Privasi</summary>
            <p>Isian rencana acara diproses di perangkat Anda dan diteruskan ke WhatsApp saat Anda memilih untuk melanjutkan. Situs ini tidak menyimpan isian tersebut di server. Jika Anda mengirim pesan, SAMARA menggunakan informasi dalam pesan untuk menanggapi pertanyaan dan mengatur survei atau pemesanan. WhatsApp dan Google Maps memproses data sesuai kebijakan layanan mereka.</p>
          </details>
        </div>
      </div>
    </footer>

    <aside class="sticky-contact" aria-label="Kontak cepat" hidden>
      <WhatsApp label="Tanya Jadwal" class="button--primary" />
    </aside>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
